# ── 데이터 계약 ────────────────────────────────────────────────────────────
# semantic_sql과 달리 이 도구는 계약서를 소스에 들고 있지 않습니다. 스튜디오에
# 등록된 데이터소스의 스키마를 읽어 그때그때 계약서로 씁니다.
#
# 그렇게 한 이유는 스키마가 에이전트보다 자주 바뀌기 때문입니다. 컬럼 하나
# 추가에 에이전트를 다시 생성해야 한다면 아무도 하지 않습니다.
#
# 화이트리스트가 느슨해진 것은 아닙니다. 계약서의 출처가 소스에서 DB로 옮겨갔을
# 뿐, 여기 없는 테이블·컬럼은 여전히 컴파일 단계에서 거부됩니다.
#
# 캐시는 두지 않습니다. 호출마다 인덱스 조회 한 번이고, 그 값으로 스키마 변경이
# 즉시 반영되는 쪽을 삽니다 — 프로세스에 캐시를 들고 있으면 동기화를 눌러도
# 돌고 있는 에이전트만 옛 스키마를 계속 보고, 그 증상은 원인이 안 보입니다.

# ── 탐색 결과 예산 ─────────────────────────────────────────────────────────
# 1단계가 돌려준 스키마는 그대로 프롬프트에 남아 2단계까지 따라다닙니다.
# 게이트웨이 모델의 컨텍스트가 16k라 이 예산이 곧 실패 여부입니다.
MAX_COLUMNS = 30
MAX_CHARS = 3000
# 한 질문에 붙일 테이블 수. 늘리면 조인을 못 하는 컴파일러에 쓸모없는 테이블만
# 더 붙습니다.
MAX_TABLES = 3

# ── 실행 예산 ──────────────────────────────────────────────────────────────
# 이 도구는 SQL을 만들고 **실행해서 행을 돌려줍니다**. 그래서 상한이 있어야
# 합니다. 실제 사례: 센서 한 대의 일주일치가 2,000행, 한 지점의 TDK 6개면
# 12,000행입니다. 그것을 프롬프트에 밀어넣으면 답을 만들기 전에 컨텍스트가
# 끝납니다. 시계열 질문의 정답은 원시 행이 아니라 time_bucket 집계입니다.
DEFAULT_ROWS = 200
MAX_ROWS = 1000
MAX_RESULT_CHARS = 3000
# 대상 DB에 거는 시간 제한. 인덱스 없는 컬럼에 걸린 범위 조건 하나면 몇 분씩
# 도는 쿼리가 나오고, 그동안 에이전트는 아무것도 못 합니다.
QUERY_TIMEOUT_MS = 30000

_FUNCTIONS = ("SUM", "COUNT", "AVG", "MIN", "MAX")

# 값 하나를 받는 비교. 범위 조건에 경계가 필요해서 >=, <=가 함께 있습니다 —
# `>`와 `<`만으로 기간을 자르면 시작일과 종료일이 조용히 빠집니다.
_OPERATORS = {
    "equals": "=",
    "not_equals": "!=",
    "greater_than": ">",
    "greater_or_equal": ">=",
    "less_than": "<",
    "less_or_equal": "<=",
}
# 값 목록을 받는 비교. 하나의 "센서"에 장치 주소가 여럿 매달린 스키마가 흔해서,
# 이것이 없으면 같은 질문을 장치 수만큼 반복해야 합니다.
_LIST_OPERATORS = {"in": "IN", "not_in": "NOT IN"}

# 드라이버별 식별자 인용 문자. MySQL은 백틱, PostgreSQL은 쌍따옴표입니다.
# 잘못 고르면 예약어 컬럼(`status`, `order`, `rank`)에서 문법 오류가 납니다.
_QUOTE = {"mysql": "`", "postgresql": '"'}

# 시간 버킷. 표현식이므로 문자열을 조립하지만, unit은 아래 표의 키로만 들어올
# 수 있어 모델이 무엇을 적어 보내도 이 중 하나가 되거나 거부됩니다.
#
# MariaDB에는 date_trunc가 없어서 DATE_FORMAT으로 같은 일을 합니다. 형식
# 문자열은 여기 고정되어 있고 사용자 입력이 닿지 않습니다.
_BUCKETS = {
    "postgresql": {
        "minute": "date_trunc('minute', {col})",
        "hour": "date_trunc('hour', {col})",
        "day": "date_trunc('day', {col})",
        "month": "date_trunc('month', {col})",
    },
    "mysql": {
        "minute": "DATE_FORMAT({col}, '%Y-%m-%d %H:%i:00')",
        "hour": "DATE_FORMAT({col}, '%Y-%m-%d %H:00:00')",
        "day": "DATE_FORMAT({col}, '%Y-%m-%d')",
        "month": "DATE_FORMAT({col}, '%Y-%m-01')",
    },
}

_DIRECTIONS = {"asc": "ASC", "desc": "DESC"}

# 시각을 문자열 컬럼에 담아둔 스키마가 흔합니다 — 실제로 만난 것이
# `utctime character varying(50)`에 `'2026/07/27 21:00:00'`입니다. 그런 컬럼에
# date_trunc를 걸면 "function date_trunc(unknown, character varying) does not
# exist"로 죽고, 모델은 그 메시지에서 회복하지 못합니다.
_TIMESTAMP_CAST = {
    "postgresql": "CAST({col} AS timestamp)",
    "mysql": "CAST({col} AS DATETIME)",
}


def _is_text_type(type_name: str) -> bool:
    """선언된 타입이 문자열 계열인가. `character varying(50)`, `text`, `char(10)`."""
    lowered = (type_name or "").lower()
    return any(word in lowered for word in ("char", "text", "clob"))


def _fetch(sql: str, params: tuple) -> list:
    """스튜디오 DB에 한 번 묻고 끝냅니다.

    풀을 두지 않는 것은 이 파일이 단독 실행도 되기 때문입니다 — 생성된 에이전트를
    `uv run`으로 돌릴 때 붙잡고 있을 프로세스가 없습니다.
    """
    import psycopg

    with psycopg.connect(DB_URL) as connection:
        with connection.cursor() as cursor:
            cursor.execute(sql, params)
            return cursor.fetchall()


def _list_databases() -> str:
    """등록된 데이터소스 목록. 모델이 `database`에 무엇을 적을지 여기서 봅니다."""
    rows = _fetch(
        "SELECT d.name, d.description, d.driver, d.synced_at,"
        "       (SELECT count(*) FROM datasource_table t"
        "         WHERE t.datasource_id = d.id)"
        "  FROM datasource d ORDER BY d.name",
        (),
    )
    if not rows:
        return (
            "등록된 데이터베이스가 없습니다. 스튜디오의 데이터소스 화면에서 "
            "DB를 등록하고 스키마를 동기화해야 이 도구를 쓸 수 있습니다."
        )

    lines = []
    for name, description, driver, synced_at, table_count in rows:
        note = f"테이블 {table_count}개"
        if synced_at is None:
            # 동기화 전에는 계약서가 비어 있습니다. 목록에서 감추면 모델은 이름을
            # 골랐다가 "테이블이 없다"는 답만 받고 이유를 알지 못합니다.
            note = "아직 스키마를 동기화하지 않음 — 조회할 수 없습니다"
        lines.append(f"{name} ({driver}) — {description or '(설명 없음)'} [{note}]")

    return "사용할 수 있는 데이터베이스:\n" + "\n".join(f"  {line}" for line in lines)


def _load_contract(database: str) -> dict:
    """이름으로 데이터소스를 찾아 그 스키마를 계약서로 만듭니다.

    접속 정보까지 함께 싣습니다. 컴파일된 SQL을 실행해야 하고, 그 접속 정보는
    등록 시점에 저장된 것을 씁니다 — 모델이 호스트나 계정을 고를 여지는 없습니다.

    @raises ValueError 이름이 없을 때. 등록된 이름을 함께 실어야 모델이 스스로
    고쳐 다시 부를 수 있습니다.
    """
    found = _fetch(
        "SELECT id, name, driver, host, port, db_name, db_schema, username, password"
        "  FROM datasource WHERE lower(name) = lower(%s)",
        (database,),
    )
    if not found:
        known = _fetch("SELECT name FROM datasource ORDER BY name", ())
        raise ValueError(
            f"등록되지 않은 데이터베이스입니다 -> {database!r} "
            f"(사용 가능: {', '.join(r[0] for r in known) or '없음'})"
        )

    (datasource_id, name, driver, host, port, db_name, db_schema, username,
     password) = found[0]
    rows = _fetch(
        # 별칭을 붙이는 것은 이 다섯 개 중 이름이 겹치는 것이 둘 있기 때문입니다 —
        # t.name/c.name, t.description/c.description. 튜플로 받는 한 상관없지만,
        # 나중에 누가 dict 커서로 바꾸면 겹친 쪽이 조용히 하나로 합쳐집니다.
        "SELECT t.name AS table_name, t.description AS table_note,"
        "       c.name AS column_name, c.data_type, c.description AS column_note"
        "  FROM datasource_table t"
        "  LEFT JOIN datasource_column c ON c.table_id = t.id"
        " WHERE t.datasource_id = %s"
        " ORDER BY t.name, c.ordinal",
        (datasource_id,),
    )

    tables = {}
    for table_name, table_note, column, data_type, column_note in rows:
        table = tables.get(table_name)
        if table is None:
            table = {"name": table_name, "description": table_note or "", "columns": []}
            tables[table_name] = table
        # LEFT JOIN이라 컬럼 없는 테이블은 NULL 한 줄로 옵니다.
        if column is not None:
            table["columns"].append({
                "name": column,
                "type": data_type or "",
                "description": column_note or "",
            })

    if not tables:
        raise ValueError(
            f"{name!r}의 스키마가 비어 있습니다. 스튜디오에서 이 데이터소스를 "
            "동기화한 뒤 다시 시도하십시오"
        )
    return {
        "name": name,
        "driver": driver,
        "tables": list(tables.values()),
        "connection": {
            "host": host, "port": port, "dbname": db_name,
            "schema": db_schema, "user": username, "password": password,
        },
    }


def _list_tables(contract: dict, pattern: str) -> str:
    """이 DB에 무슨 테이블이 있는지. `pattern`이 '*'면 전부, 아니면 부분 일치.

    탐색(`question`)과는 다른 질문에 답합니다. 탐색은 "이 질문에 관련된 것"을
    돌려주는 프루너이고, 이것은 "무엇이 있는가"입니다. 그 둘을 한 입구로 묶어
    두었더니, 사용자가 "테이블 목록 보여줘"라고 물었을 때 프루너가 의미 없는
    질의에 대한 상위 3개를 돌려주고 모델이 그것을 전체 목록이라고 답했습니다.

    전부는 대개 못 보여줍니다 — 실제 DB가 371개, 이름만 2,161토큰입니다. 그래서
    상한에서 자르고, 자랐다는 사실과 좁히는 방법을 함께 말합니다.
    """
    needle = "" if pattern.strip() == "*" else pattern.strip().lower()
    matching = [
        t for t in contract["tables"]
        if not needle
        or needle in t["name"].lower()
        or needle in (t.get("description") or "").lower()
    ]
    total = len(contract["tables"])

    if not matching:
        return (
            f"{contract['name']}의 테이블 {total}개 중 {pattern!r}과(와) 일치하는 "
            "것이 없습니다. 이름 일부를 다르게 적어보거나 '*'로 전체를 보십시오"
        )

    lines = []
    for table in matching:
        note = table.get("description") or ""
        lines.append(f"  {table['name']}" + (f" — {note}" if note else ""))

    head = f"DATABASE {contract['name']} — 테이블 {total}개"
    if needle:
        head += f", {pattern!r} 일치 {len(matching)}개"

    text = "\n".join([head, *lines])
    if len(text) > MAX_CHARS:
        text = text[:MAX_CHARS].rsplit("\n", 1)[0]
        shown = text.count("\n")
        # 몇 개를 보고 있는지 반드시 말합니다. 이것이 없으면 모델은 보인 것이
        # 전부라고 답하고, 그 답은 틀렸다는 표시가 어디에도 없습니다.
        text += (
            f"\n... ({len(matching)}개 중 {shown}개만 보입니다. "
            "tables에 이름 일부를 넣어 좁히십시오)"
        )
    return text


def _looks_like_listing(question: str) -> bool:
    """"무슨 테이블이 있어?" 류의 질문인가.

    프루너에 흘려보내면 관련도 상위 몇 개가 나오고, 그것이 전체 목록으로 읽힙니다.
    알아보고 `tables`로 안내하는 편이 조용히 틀린 답을 주는 것보다 낫습니다.
    """
    import re

    text = (question or "").strip().lower()
    if not re.search(r"테이블|table", text):
        return False
    # "목록"류가 있거나, 의문사와 "있"이 함께 오거나 — "무슨 테이블이 있어",
    # "어떤 테이블이 있는지". 의문사만으로는 부족합니다: "어떤 센서가 변위가
    # 큰지"는 테이블 목록을 묻는 것이 아닙니다.
    if re.search(r"목록|리스트|전체|모든|다\s*보여|\blist\b|show\s+tables", text):
        return True
    return bool(re.search(r"(무슨|어떤|뭐가|뭐\s|무엇)", text)
                and re.search(r"있", text))


def _tokens(text: str) -> list:
    """단어로 쪼갠 결과. 한글은 글자 2-gram으로 끊습니다.

    공백으로만 자르면 "매출액의"와 "매출액"이 서로 다른 토큰이 되어, 조사 하나
    때문에 관련 테이블을 놓칩니다. 2-gram이면 "매출","출액"이 겹쳐서 잡힙니다.
    """
    import re

    found = []
    for match in re.finditer(r"[a-z0-9_]+|[가-힣一-鿿]+", text.lower()):
        chunk = match.group()
        if chunk[0].isascii():
            found.append(chunk)
        elif len(chunk) == 1:
            found.append(chunk)
        else:
            found.extend(chunk[i : i + 2] for i in range(len(chunk) - 1))
    return found


class _Pruner:
    """질문과 관련 있는 테이블만 골라냅니다.

    스키마 전체를 프롬프트에 넣으면 테이블이 늘어날수록 토큰과 노이즈가 같이
    늘고, 모델이 엉뚱한 테이블을 고를 여지도 같이 커집니다. 등록된 DB를 통째로
    읽어오는 이 도구에서는 semantic_sql보다 더 중요합니다 — 손으로 고른 몇 개가
    아니라 그 DB에 있는 전부가 후보이고, 실제로 371개짜리 스키마를 받습니다.

    TF-IDF를 직접 구현한 이유는 의존성입니다. scikit-learn은 numpy·scipy까지
    100MB가 넘고, 생성된 에이전트는 `uv run`으로 제 의존성을 직접 설치합니다.
    """

    def __init__(self, contract: dict) -> None:
        self.entries = []
        for table in contract["tables"]:
            text = " ".join(
                [table["name"], table.get("description", "")]
                + [c.get("description", "") for c in table["columns"]]
                + [c["name"] for c in table["columns"]]
            )
            self.entries.append((table, _tokens(text)))

        # 문서 빈도: 몇 개의 테이블에 이 토큰이 나오는가.
        self.document_count = len(self.entries) or 1
        self.frequency = {}
        for _table, tokens in self.entries:
            for token in set(tokens):
                self.frequency[token] = self.frequency.get(token, 0) + 1

    def _weights(self, tokens: list) -> dict:
        """TF-IDF 벡터. IDF는 로그 스무딩이라 모든 항목에 나오는 토큰도 0이 아닙니다."""
        import math

        counts = {}
        for token in tokens:
            counts[token] = counts.get(token, 0) + 1

        weights = {}
        for token, count in counts.items():
            appears = self.frequency.get(token, 0)
            idf = math.log(self.document_count / (1 + appears)) + 1.0
            weights[token] = count * idf
        return weights

    def _cosine(self, left: dict, right: dict) -> float:
        import math

        shared = set(left) & set(right)
        if not shared:
            return 0.0
        dot = sum(left[token] * right[token] for token in shared)
        size = math.sqrt(sum(v * v for v in left.values())) * math.sqrt(
            sum(v * v for v in right.values())
        )
        return dot / size if size else 0.0

    def prune(self, question: str, top_k: int = MAX_TABLES, relative: float = 0.3) -> list:
        """상위 top_k개 중, 1등 점수의 `relative` 배 이상인 테이블만.

        고정 개수로만 자르면 한 테이블이 압도적으로 관련 있을 때도 2등이 딸려
        옵니다. 상대 문턱이 그런 찌꺼기만 떨굽니다.
        """
        query = self._weights(_tokens(question))
        scored = sorted(
            ((self._cosine(query, self._weights(tokens)), table)
             for table, tokens in self.entries),
            key=lambda row: row[0],
            reverse=True,
        )

        best = scored[0][0] if scored else 0.0
        floor = best * relative
        picked = [table for score, table in scored[:top_k] if score > 0 and score >= floor]

        # 아무것도 걸리지 않으면 점수 순 상위 몇 개라도 보여줍니다. 빈 스키마를
        # 받은 모델은 컬럼을 지어내기 시작하고, 그 편이 나쁩니다.
        return picked or [table for _score, table in scored[:top_k]]


def _describe(tables: list, question: str, contract: dict) -> str:
    """프루닝 결과를 모델이 읽을 압축 텍스트로.

    JSON을 버린 이유는 순전히 크기입니다. 같은 내용이 들여쓴 JSON에서는 컬럼당
    130자, 여기서는 30자 안팎입니다.
    """
    # 몇 개 중에서 고른 것인지 반드시 밝힙니다. 이 한 줄이 없어서, "테이블 목록"
    # 이라는 질문에 프루너가 돌려준 3개를 모델이 전체 목록이라고 답했습니다.
    total = len(contract["tables"])
    blocks = [
        f"DATABASE {contract['name']} ({contract['driver']}) — 테이블 {total}개 중 "
        f"질문에 관련된 {len(tables)}개입니다. 전체 목록은 tables 인자로 보십시오"
    ]

    # 테이블 여러 개가 잡히면 예산을 나눠 씁니다. 각자 30개씩 가져가면 총량이
    # 상한을 넘고, 그때는 마지막 테이블이 줄 중간에서 잘려 나갑니다.
    budget = max(8, MAX_COLUMNS // max(len(tables), 1))

    for table in tables:
        shown, hidden = _pick_columns(table["columns"], question, budget)
        head = f"TABLE {table['name']}"
        if table.get("description"):
            head += f" — {table['description']}"
        if hidden:
            head += f"  (컬럼 {len(table['columns'])}개 중 질문에 가까운 {len(shown)}개만)"

        rows = [
            f"  {c['name']} {c.get('type', '')} {c.get('description', '')}".rstrip()
            for c in shown
        ]
        blocks.append("\n".join([head, *rows]))

    text = "\n\n".join(blocks)
    if len(text) > MAX_CHARS:
        # 마지막 온전한 줄까지만. 줄 한가운데서 자르면 반쪽짜리 컬럼 이름이
        # 남고, 모델은 그것을 진짜 이름으로 받아 적습니다.
        text = text[:MAX_CHARS].rsplit("\n", 1)[0]
        text += "\n... (길어서 잘랐습니다. 질문을 좁혀 다시 물어보세요)"
    return text


def _pick_columns(columns: list, question: str, limit: int):
    """넓은 테이블에서 질문에 가까운 컬럼만 고릅니다. (고른 것, 감춘 개수)

    105개짜리 테이블을 통째로 내보내면 그 한 번으로 컨텍스트가 끝납니다. 질문과
    겹치는 토큰이 많은 순으로 고르되, **원래 순서로 되돌려** 내보냅니다 — 점수순
    나열은 사람이 읽기 어렵고, 컬럼 순서에는 키가 앞에 오는 정보가 들어 있습니다.
    """
    if len(columns) <= limit:
        return columns, 0

    wanted = set(_tokens(question))

    def overlap(column: dict) -> int:
        text = f"{column['name']} {column.get('description', '')}"
        return len(wanted & set(_tokens(text)))

    ranked = sorted(columns, key=overlap, reverse=True)[:limit]
    keep = {id(c) for c in ranked}
    shown = [c for c in columns if id(c) in keep]
    return shown, len(columns) - len(shown)


def _match(name, options):
    """대소문자를 무시하고 이름을 찾아 계약서에 적힌 표기로 돌려줍니다.

    스키마의 이름이 전부 대문자여도 모델은 소문자로 적는 쪽으로 기웁니다. DB가
    받아줬을 쿼리를 우리가 거절할 이유는 없습니다.

    화이트리스트가 느슨해지는 것은 아닙니다. 계약서에 없는 이름은 그대로 없고,
    SQL에 나가는 것은 언제나 계약서 쪽 표기입니다.
    """
    if not isinstance(name, str):
        return None
    if name in options:
        return name
    lowered = name.lower()
    for candidate in options:
        if candidate.lower() == lowered:
            return candidate
    return None


class _Compiler:
    """검증된 AST를 SQL로 조립합니다.

    모델이 무엇을 넘기든 여기서 화이트리스트를 통과하지 못하면 SQL이 되지
    않습니다. 테이블·컬럼·집계함수·연산자·버킷단위·정렬방향 모두 목록에 있는
    것만 허용합니다.

    **이 컴파일러는 SELECT 외의 것을 만들 수 없습니다.** 절 하나하나를 여기서
    조립하고, 모델의 문자열이 구조에 끼어들 자리가 없습니다 — 실행 기능을 붙일
    수 있는 근거가 그것입니다.
    """

    def __init__(self, contract: dict) -> None:
        self.columns = {
            t["name"]: [c["name"] for c in t["columns"]] for t in contract["tables"]
        }
        # 선언된 타입. 시각이 문자열로 저장된 컬럼을 알아보려면 이름만으로는 안 됩니다.
        self.types = {
            t["name"]: {c["name"]: c.get("type", "") for c in t["columns"]}
            for t in contract["tables"]
        }
        self.driver = contract["driver"]
        self.quote = _QUOTE.get(self.driver, '"')
        self.buckets = _BUCKETS.get(self.driver, _BUCKETS["postgresql"])
        self.cast = _TIMESTAMP_CAST.get(self.driver, _TIMESTAMP_CAST["postgresql"])

    KEYS = {
        "target_table", "columns", "aggregations", "time_bucket",
        "filters", "group_by", "order_by", "limit",
    }

    # 모델이 자주 시도하지만 이 컴파일러가 만들지 않는 것들. 이름을 알아보고
    # 무엇이 없는지 말해주는 편이, 낯선 키라고만 하는 것보다 고쳐 쓰기 쉽습니다.
    UNSUPPORTED = {
        "having": "집계 결과 필터(HAVING)",
        "joins": "테이블 조인(JOIN)",
        "join": "테이블 조인(JOIN)",
        "distinct": "중복 제거(DISTINCT)",
        "subquery": "서브쿼리",
        "metric": "지표(metric) 기반 조회",
    }

    def compile(self, ast: dict) -> str:
        # 모르는 키를 무시하면 "상위 10개만"이라는 질문에 LIMIT 없는 쿼리가
        # 나가고, 아무도 그 사실을 말하지 않습니다. 모델은 답했다고 믿고
        # 사용자에게 내놓습니다 — 에러보다 나쁜 결과입니다.
        unknown = set(ast) - self.KEYS
        if unknown:
            named = [self.UNSUPPORTED[k] for k in sorted(unknown) if k in self.UNSUPPORTED]
            other = sorted(k for k in unknown if k not in self.UNSUPPORTED)
            parts = []
            if named:
                parts.append(
                    "이 도구는 " + ", ".join(dict.fromkeys(named)) + "을(를) 만들지 않습니다"
                )
            if other:
                parts.append(f"모르는 항목입니다 -> {', '.join(other)}")
            raise ValueError(
                "; ".join(parts)
                + ". 쓸 수 있는 것: " + ", ".join(sorted(self.KEYS))
                + ". 그 범위로 다시 만들거나, 불가능하면 사용자에게 그렇게 답하십시오"
            )

        table = _match(ast.get("target_table"), self.columns)
        if table is None:
            raise ValueError(
                f"조회할 수 없는 테이블입니다 -> {ast.get('target_table')!r} "
                f"(사용 가능: {', '.join(self.columns)})"
            )
        allowed = self.columns[table]

        # SELECT 절은 세 조각이 순서대로 붙습니다: 시간 버킷, 맨 컬럼, 집계.
        # 시계열이면 버킷이 첫 컬럼이어야 사람이 읽기 좋습니다.
        select, aliases, grouping = [], [], []

        bucket = ast.get("time_bucket")
        # 버킷을 건 컬럼은 이 질의가 시각이라고 선언한 것입니다. 같은 컬럼에 걸린
        # 범위 조건도 시각으로 비교해야 합니다.
        #
        # 문자열로 두면 결과가 **collation에 달립니다.** `'2026/07/27 21:00:00'
        # < '2026-08-31'`은 en_US.UTF-8에서 참(구두점을 무시하고 숫자를 비교),
        # `C`에서는 거짓(`/`=0x2F > `-`=0x2D)입니다. 형식이 섞이면 그마저 무너져
        # `'2026/09/01 05:00' < '2026/09/01 05:00:00'`이 참이 됩니다.
        #
        # 어느 쪽도 오류를 내지 않고 그냥 다른 답을 줍니다. 캐스팅은 그 의존성을
        # 없애 DB 설정과 무관하게 같은 결과가 나오게 합니다.
        temporal = (_match(bucket.get("field"), allowed)
                    if isinstance(bucket, dict) else None)
        if bucket:
            expression, alias = self._bucket(bucket, table, allowed)
            select.append(f"{expression} AS {self._alias(alias)}")
            aliases.append(alias)
            # 버킷은 그 자체가 그룹화 키입니다. 모델에게 group_by에 또 적으라고
            # 요구하면 잊고, 잊으면 DB가 문법 오류를 냅니다.
            grouping.append(expression)

        plain = []
        for column in ast.get("columns") or []:
            resolved = _match(column, allowed)
            if resolved is None:
                raise ValueError(f"존재하지 않는 컬럼입니다 -> {table}.{column}")
            plain.append(resolved)
            select.append(self._identifier(resolved))
            aliases.append(resolved)

        aggregations = ast.get("aggregations") or []
        for spec in aggregations:
            rendered, alias = self._aggregation(spec, table, allowed)
            select.append(rendered)
            aliases.append(alias)

        for column in ast.get("group_by") or []:
            resolved = _match(column, allowed)
            if resolved is None:
                raise ValueError(f"그룹화할 수 없는 컬럼입니다 -> {table}.{column}")
            grouping.append(self._identifier(resolved))

        # 집계와 맨 컬럼이 섞이면 맨 컬럼은 전부 GROUP BY에 있어야 합니다. 조용히
        # 넣어주면 모델이 의도하지 않은 그룹이 생기고, 그대로 내보내면 DB가
        # 문법 오류를 냅니다 — 어느 쪽도 도움이 안 되므로 이름을 대고 거부합니다.
        if aggregations and plain:
            missing = [c for c in plain
                       if self._identifier(c) not in grouping]
            if missing:
                raise ValueError(
                    "집계와 함께 고른 컬럼은 group_by에도 있어야 합니다 -> "
                    + ", ".join(missing)
                )

        clauses = [f"SELECT {', '.join(select) or '*'}",
                   f"FROM {self._identifier(table)}"]

        where = [self._filter(f, table, allowed, temporal)
                 for f in (ast.get("filters") or [])]
        if where:
            clauses.append("WHERE " + " AND ".join(where))
        if grouping:
            clauses.append("GROUP BY " + ", ".join(grouping))

        ordering = [self._order(o, table, allowed, aliases)
                    for o in (ast.get("order_by") or [])]
        if ordering:
            clauses.append("ORDER BY " + ", ".join(ordering))

        clauses.append(f"LIMIT {self._limit(ast.get('limit'))}")
        return " ".join(clauses) + ";"

    def _limit(self, value) -> int:
        """행수 상한. 없으면 기본값이 붙고, 상한을 넘겨 달라고 해도 깎입니다.

        LIMIT이 **항상** 붙는 것이 요점입니다. 결과를 실행해서 돌려주는 도구에서
        상한 없는 SELECT 한 번은 프롬프트가 아니라 프로세스를 끝냅니다.
        """
        if value is None:
            return DEFAULT_ROWS
        if isinstance(value, bool) or not isinstance(value, int):
            raise ValueError(f"limit은 정수여야 합니다 -> {value!r}")
        if value < 1:
            raise ValueError(f"limit은 1 이상이어야 합니다 -> {value}")
        return min(value, MAX_ROWS)

    def _bucket(self, spec, table: str, allowed: list):
        """시간 컬럼을 분·시·일·월 단위로 묶는 표현식. (SQL, 별칭)

        시계열 질문에 이것이 없으면 답할 방법이 없습니다. 원시 행을 돌려주면
        일주일치가 수천 행이고, 시 단위로 묶으면 168개입니다.
        """
        if not isinstance(spec, dict):
            raise ValueError(
                'time_bucket은 {"field": "...", "unit": "hour"} 형태여야 합니다 '
                f"-> {spec!r}"
            )
        field = _match(spec.get("field"), allowed)
        if field is None:
            raise ValueError(f"존재하지 않는 컬럼입니다 -> {table}.{spec.get('field')}")

        unit = str(spec.get("unit", "")).lower()
        if unit not in self.buckets:
            raise ValueError(
                f"쓸 수 없는 시간 단위입니다 -> {spec.get('unit')!r} "
                f"(사용 가능: {', '.join(self.buckets)})"
            )
        expression = self.buckets[unit].format(col=self._temporal(table, field))
        return expression, spec.get("alias") or f"{field}_{unit}"

    def _temporal(self, table: str, field: str) -> str:
        """시각으로 다룰 컬럼. 문자열 타입이면 캐스팅해서 내보냅니다.

        시각을 varchar에 담아둔 스키마가 드물지 않고, 그런 컬럼에 date_trunc를
        그대로 걸면 함수가 없다는 오류로 죽습니다. 모델은 그 메시지를 보고
        캐스팅을 시도하지만 이 도구에는 표현식을 넘길 자리가 없어서, 같은 질의를
        반복하다 반복 한도를 다 씁니다 — 실제로 그렇게 12턴을 태웠습니다.

        캐스팅이 실패할 수는 있습니다(형식이 제각각인 문자열). 하지만 그때는
        DB가 그 값을 알려주며 실패하고, 지금처럼 "함수가 없다"는, 고칠 방법이
        보이지 않는 오류와는 다릅니다.
        """
        column = self._identifier(field)
        if _is_text_type(self.types.get(table, {}).get(field, "")):
            return self.cast.format(col=column)
        return column

    def _aggregation(self, spec: dict, table: str, allowed: list):
        """집계 하나. (SQL, 별칭)"""
        if not isinstance(spec, dict):
            raise ValueError(f"aggregations의 항목은 객체여야 합니다 -> {spec!r}")
        field = spec.get("field")
        function = str(spec.get("function", "")).upper()
        alias = spec.get("alias") or f"{function.lower()}_{field}"

        if function not in _FUNCTIONS:
            raise ValueError(
                f"허용되지 않은 집계 함수입니다 -> {function!r} "
                f"(사용 가능: {', '.join(_FUNCTIONS)})"
            )
        resolved = field if field == "*" else _match(field, allowed)
        if resolved is None:
            raise ValueError(f"존재하지 않는 컬럼입니다 -> {table}.{field}")
        # COUNT(*)의 별은 컬럼이 아니라 문법이라 감싸면 안 됩니다.
        target = "*" if field == "*" else self._identifier(resolved)
        return f"{function}({target}) AS {self._alias(alias)}", alias

    def _order(self, spec, table: str, allowed: list, aliases: list) -> str:
        """정렬 하나. 시계열은 정렬이 정의의 일부라 이것 없이는 성립하지 않습니다.

        SELECT가 만들어낸 별칭으로도 정렬할 수 있어야 합니다 — 시간 버킷이나
        집계 결과로 정렬하는 것이 시계열 질문에서 가장 흔한 요구인데, 그 둘은
        테이블 컬럼이 아닙니다. MySQL과 PostgreSQL 모두 출력 컬럼명으로
        정렬하는 것을 받습니다.
        """
        if not isinstance(spec, dict):
            raise ValueError(
                'order_by의 항목은 {"field": "...", "direction": "asc"} '
                f"형태여야 합니다 -> {spec!r}"
            )
        field = spec.get("field")
        resolved = _match(field, allowed) or _match(field, aliases)
        if resolved is None:
            raise ValueError(
                f"정렬할 수 없는 이름입니다 -> {field!r} "
                f"({table}의 컬럼이거나 이 질의가 만든 별칭이어야 합니다"
                + (f"; 별칭: {', '.join(aliases)}" if aliases else "")
                + ")"
            )

        direction = str(spec.get("direction", "asc")).lower()
        if direction not in _DIRECTIONS:
            raise ValueError(
                f"정렬 방향은 asc 또는 desc여야 합니다 -> {spec.get('direction')!r}"
            )
        return f"{self._identifier(resolved)} {_DIRECTIONS[direction]}"

    def _identifier(self, name: str) -> str:
        """계약서에 있는 이름을 드라이버의 인용 문자로 감쌉니다.

        예약어가 목적입니다: `status`, `order`, `rank`는 모두 그럴듯한 컬럼명이면서
        예약어라, 감싸지 않으면 문법 오류가 납니다.

        영문/숫자/밑줄만 받으면 안 됩니다. 실제 스키마에는 `평균기온(°C)`,
        `사고원인-대분류` 같은 컬럼이 있고, 인용만 하면 DB는 문제없이 받습니다.

        인용 부호 안에서 특별한 문자는 인용 부호 자신뿐이라, 그것과 NUL만
        거부하면 인용이 깨지지 않습니다. 이름은 이미 계약서 화이트리스트를
        통과한 것이므로 주입 경로도 아닙니다.
        """
        text = str(name)
        if not text:
            raise ValueError("빈 식별자는 쓸 수 없습니다")
        if self.quote in text or "\x00" in text:
            raise ValueError(
                f"식별자에 {self.quote}나 NUL을 쓸 수 없습니다 -> {name!r}"
            )
        return f"{self.quote}{text}{self.quote}"

    def _alias(self, alias: str) -> str:
        """별칭은 계약서에 없는, 모델이 그때그때 지어내는 유일한 식별자입니다.

        화이트리스트가 받쳐주지 않는데도 컬럼명과 같은 문자 규칙을 씁니다. 인용
        부호 안에서 특별한 문자는 인용 부호뿐이므로, 그것만 막으면 모델이 무엇을
        적어 보내든 SQL 구조에 영향을 주지 못하고 이름으로만 남습니다.

        길이와 공백은 별칭에만 있는 제약입니다. 식별자는 64자를 넘을 수 없고
        공백으로 끝날 수 없는데, 계약서의 이름과 달리 모델의 별칭은 그 둘을
        지킨다는 보장이 없습니다.
        """
        text = str(alias)
        if not text or text != text.strip():
            raise ValueError(f"별칭은 비어 있거나 공백으로 끝날 수 없습니다 -> {alias!r}")
        if len(text) > 64:
            raise ValueError(f"별칭은 64자를 넘을 수 없습니다 -> {text[:20]}...")
        if self.quote in text or "\x00" in text:
            raise ValueError(f"별칭에 {self.quote}나 NUL을 쓸 수 없습니다 -> {alias!r}")
        return f"{self.quote}{text}{self.quote}"

    def _filter(self, spec: dict, table: str, allowed: list,
                temporal: str = None) -> str:
        if not isinstance(spec, dict):
            raise ValueError(f"filters의 항목은 객체여야 합니다 -> {spec!r}")
        field = spec.get("field")
        operator = spec.get("operator")

        resolved = _match(field, allowed)
        if resolved is None:
            raise ValueError(f"필터링할 수 없는 컬럼입니다 -> {table}.{field}")

        # 이 질의가 시각으로 다루기로 한 컬럼이면 비교도 시각으로. `in`은 값이
        # 정확히 일치하는지를 보는 것이라 사전순이든 시각순이든 결과가 같으므로
        # 굳이 캐스팅하지 않습니다.
        column = (self._temporal(table, resolved)
                  if resolved == temporal and operator in _OPERATORS
                  else self._identifier(resolved))

        if operator in _LIST_OPERATORS:
            values = spec.get("value")
            if not isinstance(values, (list, tuple)) or not values:
                raise ValueError(
                    f"{operator!r}의 value는 비어 있지 않은 목록이어야 합니다 "
                    f"-> {values!r}"
                )
            rendered = ", ".join(self._literal(v) for v in values)
            return f"{column} {_LIST_OPERATORS[operator]} ({rendered})"

        if operator not in _OPERATORS:
            raise ValueError(
                f"허용되지 않는 비교 연산자입니다 -> {operator!r} (사용 가능: "
                f"{', '.join(list(_OPERATORS) + list(_LIST_OPERATORS))})"
            )
        return f"{column} {_OPERATORS[operator]} {self._literal(spec.get('value'))}"

    def _literal(self, value) -> str:
        """값을 SQL 리터럴로. 식별자와 달리 값은 화이트리스트로 막을 수 없습니다.

        **MySQL에서 백슬래시 거부는 선택이 아닙니다.** MySQL/MariaDB는 기본
        sql_mode에 NO_BACKSLASH_ESCAPES가 없어서 문자열 안의 백슬래시가
        이스케이프 문자입니다. 홑따옴표 겹치기만으로 막으면 `\\' OR 1=1 -- `
        같은 값이 `'\\'' OR 1=1 -- '`가 되고, 여기서 `\\'`가 따옴표를 이스케이프해
        리터럴을 빠져나갑니다.

        PostgreSQL은 standard_conforming_strings가 기본 on이라 백슬래시가
        평범한 문자입니다. 거기까지 거부하면 경로나 정규식이 든 값을 쓸 수 없게
        되므로, 제약은 그것이 필요한 드라이버에만 겁니다.
        """
        if isinstance(value, bool):
            return "TRUE" if value else "FALSE"
        if isinstance(value, (int, float)):
            return str(value)
        if value is None:
            return "NULL"
        if isinstance(value, (list, tuple, dict)):
            raise ValueError(f"값 하나를 받는 자리에 목록이 왔습니다 -> {value!r}")

        text = str(value)
        if "\x00" in text:
            raise ValueError("값에 NUL 문자를 넣을 수 없습니다")
        if self.driver == "mysql" and "\\" in text:
            raise ValueError(
                "값에 백슬래시를 넣을 수 없습니다 "
                "(MySQL에서 백슬래시는 이스케이프 문자입니다)"
            )
        return "'" + text.replace("'", "''") + "'"


def _run(contract: dict, sql: str):
    """컴파일된 SQL을 대상 DB에서 실행합니다. (컬럼명, 행들)

    접속 정보는 등록 시점에 저장된 것이고, SQL은 위 컴파일러가 조립한 SELECT
    하나입니다. 모델이 만든 문자열이 그대로 실행되는 경로는 없습니다.

    시간 제한을 세션에 겁니다. 인덱스 없는 컬럼에 범위 조건 하나면 몇 분씩 도는
    쿼리가 나오고, 그동안 에이전트는 멈춰 있습니다 — 그 상태는 사용자에게
    "고장"으로 보이지 "느린 쿼리"로 보이지 않습니다.
    """
    where = contract["connection"]

    if contract["driver"] == "mysql":
        import pymysql

        connection = pymysql.connect(
            host=where["host"], port=where["port"], user=where["user"],
            password=where["password"], database=where["dbname"],
            connect_timeout=10, read_timeout=QUERY_TIMEOUT_MS // 1000 + 5,
            charset="utf8mb4",
        )
        try:
            with connection.cursor() as cursor:
                _mysql_timeout(cursor)
                cursor.execute(sql.rstrip(";"))
                names = [d[0] for d in (cursor.description or [])]
                return names, cursor.fetchall()
        finally:
            connection.close()

    import psycopg
    from psycopg.conninfo import make_conninfo

    connection = psycopg.connect(
        make_conninfo(
            host=where["host"], port=where["port"], dbname=where["dbname"],
            user=where["user"] or None, password=where["password"] or None,
            connect_timeout=10,
        )
    )
    try:
        with connection.cursor() as cursor:
            cursor.execute(f"SET LOCAL statement_timeout = {QUERY_TIMEOUT_MS}")
            if where["schema"]:
                # 등록할 때 고른 스키마에서 찾게 합니다. 컴파일된 SQL은 테이블
                # 이름만 담고 스키마를 붙이지 않으므로, 이것이 없으면 public에
                # 없는 테이블은 못 찾습니다.
                cursor.execute(
                    f"SET LOCAL search_path TO {_Compiler(contract)._identifier(where['schema'])}"
                )
            cursor.execute(sql.rstrip(";"))
            names = [d.name for d in (cursor.description or [])]
            return names, cursor.fetchall()
    finally:
        connection.close()


def _mysql_timeout(cursor) -> None:
    """세션 쿼리 시간 제한. 변수 이름이 MySQL과 MariaDB에서 서로 다릅니다.

    MySQL 5.7+는 `max_execution_time`(밀리초), MariaDB는 `max_statement_time`(초)
    입니다. 서로의 것을 쓰면 "Unknown system variable"로 **질의 자체가 실패합니다**
    — 시간 제한이 안 걸리는 정도가 아니라 조회가 안 됩니다. 버전 문자열로
    갈라야 하는 이유가 그것입니다.
    """
    cursor.execute("SELECT VERSION()")
    version = str((cursor.fetchone() or [""])[0]).lower()
    if "mariadb" in version:
        cursor.execute(f"SET SESSION max_statement_time = {QUERY_TIMEOUT_MS / 1000}")
    else:
        cursor.execute(f"SET SESSION max_execution_time = {QUERY_TIMEOUT_MS}")


def _cell(value) -> str:
    """값 하나를 표에 넣을 문자열로. 소수는 유효숫자 6자리까지만.

    **이 반올림이 결과 크기의 절반을 좌우합니다.** AVG는 numeric에 대해
    `0.95994541716613271831` 같은 값을 돌려주고, 실측한 168행짜리 시계열에서
    그런 자릿수가 12,503자 중 6,936자 — 55% — 를 차지했습니다. 센서 변위 평균에
    소수점 20자리가 필요한 질문은 없는데, 그 자릿수가 컨텍스트를 먹고 상한에
    먼저 걸려 **행이 잘려 나갑니다.** 즉 정밀도를 버리는 것이 아니라, 쓸모없는
    정밀도를 버려 행을 더 담는 것입니다.

    유효숫자로 자르는 것이지 소수점 자리로 자르는 것이 아닙니다. `%.3f`로 하면
    0.0000123 같은 작은 값이 통째로 0이 됩니다 — 미세 변위를 다루는 스키마에서
    그것은 데이터를 지우는 것과 같습니다.
    """
    import decimal

    if value is None:
        return ""
    if isinstance(value, bool):
        return str(value)
    if isinstance(value, (float, decimal.Decimal)):
        text = f"{float(value):.6g}"
        # 1e+06 같은 지수 표기는 정수 자리에서는 읽기 나쁘고 자릿수도 안 줄어듭니다.
        return text if "e" not in text else f"{float(value):.6f}".rstrip("0").rstrip(".")
    return str(value)


def _render_rows(names: list, rows: list, limit_hint: int) -> str:
    """결과를 모델이 읽을 표로. 파이프로 구분한 한 줄에 한 행입니다.

    행이 상한에 정확히 닿으면 잘렸을 수 있다고 말합니다. 조용히 200행만 주면
    모델은 그것이 전부라고 믿고 "일주일 동안 200건이었습니다"라고 답합니다 —
    틀린 답이고, 틀렸다는 표시가 어디에도 없습니다.
    """
    if not rows:
        return "(조회 결과가 없습니다)"

    lines = [" | ".join(names)]
    for row in rows:
        lines.append(" | ".join(_cell(v) for v in row))

    text = "\n".join(lines)
    if len(text) > MAX_RESULT_CHARS:
        shown = text[:MAX_RESULT_CHARS].rsplit("\n", 1)[0]
        # 잘린 행들을 통계 한 줄로 대신합니다. 이것이 없으면 모델은 눈에 보이는
        # 앞부분만으로 평균을 내고 그것을 전체 기간의 값이라고 답합니다 — 잘렸다는
        # 말을 해줘도 그렇습니다. 계산할 재료가 그것뿐이기 때문입니다.
        # 30토큰 남짓으로 버려지는 행 전부의 요약을 실어보내는 셈입니다.
        summary = _summarise(names, rows)
        text = shown + "\n... (길어서 잘랐습니다"
        if summary:
            text += f"; 전체 {len(rows)}행 기준 {summary}"
        text += ". 더 줄이려면 time_bucket 단위를 키우세요)"

    note = f"({len(rows)}행"
    if len(rows) >= limit_hint:
        note += f", 상한 {limit_hint}에 도달 — 더 있을 수 있습니다"
    return text + "\n" + note + ")"


def _looks_like_sql(question: str) -> bool:
    """질문 자리에 SQL이 들어왔는가.

    SELECT로 시작하는지만 보면 "SELECT 문으로 어떻게 쓰나요?" 같은 진짜 질문까지
    막습니다. 절이 둘 이상 이어져야 SQL로 봅니다 — 사람이 자연어로 물으면서
    SELECT와 FROM을 그 순서로 함께 쓰는 일은 드뭅니다.
    """
    import re

    text = (question or "").strip().lower()
    if not text:
        return False
    if re.match(r"^\s*(select|with)\b", text) and re.search(r"\bfrom\b", text):
        return True
    return bool(re.search(r"\bselect\b.*\bfrom\b.*\b(where|group by|order by)\b", text))


def _summarise(names: list, rows: list) -> str:
    """숫자 컬럼마다 최소·평균·최대. 잘려 나간 행들이 남기는 유일한 흔적입니다."""
    import decimal

    parts = []
    for index, name in enumerate(names):
        values = [r[index] for r in rows
                  if isinstance(r[index], (int, float, decimal.Decimal))
                  and not isinstance(r[index], bool)]
        # 전부 숫자인 컬럼만. 절반만 숫자면 그 평균은 뜻이 없습니다.
        if len(values) != len(rows) or not values:
            continue
        numbers = [float(v) for v in values]
        parts.append(
            f"{name} 최소 {_cell(min(numbers))} 평균 "
            f"{_cell(sum(numbers) / len(numbers))} 최대 {_cell(max(numbers))}"
        )
    return ", ".join(parts)


@tool("nl2sql")
def nl2sql(database: str = "", question: str = "", ast: str = "",
           tables: str = "") -> str:
    """Answer a data question from a registered database, with real rows.

    Step 0 - pick a database: call with no arguments to list the registered databases.
    Step 1 - discovery: call with `database` and `question`. Returns the tables and
    columns of that database relevant to the question — a few of them, not all.
    Step 2 - run: call with `database` and `ast`, a JSON object built from what step 1
    returned. The SQL is compiled, executed, and the rows come back with it.

    To see what a database contains rather than search it, call with `database` and
    `tables`: "*" for every table, or a fragment of a name to filter. Use this, never
    `question`, when the user asks what tables exist — `question` returns the few
    tables closest to it, which is not a listing.

        {"target_table": "incl_tdk_vector_data",
         "time_bucket": {"field": "tmu", "unit": "hour", "alias": "hour"},
         "aggregations": [{"field": "spvector", "function": "AVG", "alias": "disp"}],
         "filters": [{"field": "tdkaddr", "operator": "in", "value": ["58bf", "3485"]},
                     {"field": "tmu", "operator": "greater_or_equal",
                      "value": "2026-08-31"}],
         "order_by": [{"field": "hour", "direction": "asc"}],
         "limit": 200}

    For a time series always use `time_bucket` — a week of raw sensor rows is
    thousands of rows and will not fit. Every query gets a LIMIT whether or not you
    ask for one. Never invent a table or column that step 1 did not return.
    """
    import json

    # 인자가 하나도 없으면 목록입니다. 모델이 어느 DB가 있는지 모른 채 이름을
    # 지어내는 것을 막는 것이 이 분기의 목적입니다.
    if not (database or "").strip():
        if (question or ast or tables or "").strip():
            return (
                "error: 'database'가 필요합니다. 인자 없이 호출하면 등록된 "
                "데이터베이스 목록을 볼 수 있습니다"
            )
        try:
            return _list_databases()
        except Exception as error:
            return f"error: 데이터소스 목록을 읽지 못했습니다 -> {error}"

    if not (question or ast or tables or "").strip():
        return (
            "error: 'tables'(테이블 목록), 'question'(탐색), 'ast'(조회) 중 "
            "하나는 필요합니다"
        )

    try:
        contract = _load_contract(database)
    except ValueError as error:
        return f"error: {error}"
    except Exception as error:
        return f"error: 스키마를 읽지 못했습니다 -> {error}"

    # 목록: 무엇이 있는지 묻는 것이라 프루너를 거치지 않습니다.
    if (tables or "").strip():
        return _list_tables(contract, tables)

    # 탐색: 질문만 왔으면 관련 스키마를 돌려줍니다.
    if not (ast or "").strip():
        if _looks_like_listing(question):
            return (
                "error: 'question'은 질문에 관련된 테이블 몇 개만 돌려주므로 "
                "목록이 아닙니다. 테이블 목록을 보려면 tables 인자를 쓰십시오 — "
                "'*'는 전체, 이름 일부를 넣으면 그것만 걸러 보여줍니다"
            )
        # 모델이 `question`에 SQL을 적어 보내는 일이 실제로 일어납니다. 그것을
        # 자연어로 받아 스키마를 돌려주면, 모델은 질의가 실행된 줄 알고 같은
        # 시도를 반복하다 반복 한도를 다 씁니다 — 한 대화에서 그렇게 12턴이
        # 날아갔습니다. 알아보고 자리를 알려주는 편이 훨씬 빨리 회복됩니다.
        if _looks_like_sql(question):
            return (
                "error: 'question'은 사람이 묻듯 적는 자연어 질문입니다. SQL은 "
                "여기에 넣어도 실행되지 않습니다. 질의를 실행하려면 'ast'에 "
                "JSON 질의 명세를 넣으십시오 — 표현식이나 SQL 문자열은 받지 "
                "않고, 키로 조립합니다"
            )
        return _describe(_Pruner(contract).prune(question), question, contract)

    payload = (ast or "").strip()
    # 모델이 코드펜스를 붙여 보내는 일이 흔하고, 그것 때문에 실패시킬 이유는 없습니다.
    if payload.startswith("```"):
        payload = payload.split("\n", 1)[-1].rsplit("```", 1)[0].strip()

    try:
        parsed = json.loads(payload)
    except json.JSONDecodeError as error:
        return f"error: ast가 올바른 JSON이 아닙니다 -> {error}"
    if not isinstance(parsed, dict):
        return f"error: ast는 JSON 객체여야 합니다 (받은 것: {type(parsed).__name__})"

    try:
        compiler = _Compiler(contract)
        sql = compiler.compile(parsed)
        limit = compiler._limit(parsed.get("limit"))
    except (ValueError, KeyError, TypeError) as error:
        # 예외를 올리지 않고 문자열로 돌려주는 쪽이, 모델이 스스로 고쳐 다시
        # 호출할 수 있어서 낫습니다. 실행이 끊기면 그럴 기회가 없습니다.
        return f"error: {error}"

    try:
        names, rows = _run(contract, sql)
    except Exception as error:
        # SQL은 반드시 함께 돌려줍니다. 대상 DB가 잠깐 안 되는 것과 질의가
        # 잘못된 것은 다른 문제이고, 전자라면 사용자는 이 SQL을 직접 쓸 수
        # 있습니다 — 여기서 감추면 한 번의 왕복이 통째로 버려집니다.
        reason = str(error).strip().splitlines()
        return (
            f"SQL: {sql}\n"
            f"error: 실행하지 못했습니다 -> "
            f"{reason[0] if reason else type(error).__name__}"
        )

    return f"SQL: {sql}\n\n{_render_rows(names, rows, limit)}"
