# ── 데이터 계약 ────────────────────────────────────────────────────────────
# 이 에이전트가 조회할 수 있는 테이블의 전부입니다. 여기 없는 테이블·컬럼은
# 모델이 무엇을 지시하든 컴파일 단계에서 거부됩니다.
#
# MariaDB의 DDL을 그대로 붙여넣으십시오. SHOW CREATE TABLE의 출력이든
# information_schema로 뽑은 것이든 형태는 같습니다. 여러 테이블을 이어붙여도 됩니다.
#
# 손으로 옮겨 적지 않는 이유는 COMMENT입니다. 프루너가 검색하는 본문이 바로 그
# 주석이라, 옮기는 과정에서 빠지거나 어긋나면 질문에 맞는 테이블이 안 잡힙니다.
# 스키마가 바뀌면 DDL을 다시 붙여넣는 것으로 끝나야 합니다.
_DDL = """
CREATE TABLE `TB_ASPIRIN_URL` (
  `ASPIRIN_URL_ID` varchar(36) NOT NULL COMMENT 'URL 정보 아이디',
  `ORIGINAL_URL` varchar(200) DEFAULT NULL COMMENT '인입 URL',
  `FIRST_DTTM` datetime NOT NULL DEFAULT current_timestamp() COMMENT '최초 인입 시간',
  `FINAL_DTTM` datetime(6) DEFAULT current_timestamp(6) COMMENT '최종 인입 시간',
  `LAST_URL` varchar(2083) DEFAULT NULL COMMENT '최종 URL',
  `LAST_DOMAIN` varchar(50) DEFAULT NULL COMMENT '최종 URL 도메인',
  `LAST_DUP_CNT` int(11) DEFAULT NULL COMMENT '도메인 중복 건수',
  `DOMAIN_COLLECT_YN` tinyint(1) DEFAULT NULL COMMENT '도메인 수집 여부',
  `DOMAIN_NAME` varchar(253) DEFAULT NULL COMMENT '최종 URL (도메인 제외)',
  `DOMAIN_IP` varchar(200) DEFAULT NULL COMMENT '최종 도메인 아이피',
  `DOMAIN_REGISTER` varchar(255) DEFAULT NULL COMMENT '도메인 등록자 정보',
  `DOMAIN_EMAIL` varchar(40) DEFAULT NULL COMMENT '이메일 주소 (길면 잘라서)',
  `DOMAIN_CREATE_DT` datetime DEFAULT NULL COMMENT '도메인 생성 일시',
  `DOMAIN_LAST_UPDATE_DT` datetime DEFAULT NULL COMMENT '도메인 정보 갱신 일시',
  PRIMARY KEY (`ASPIRIN_URL_ID`,`FIRST_DTTM`),
  KEY `idx_last_domain` (`LAST_DOMAIN`),
  KEY `TB_ASPIRIN_URL_FINAL_DTTM_IDX` (`FINAL_DTTM`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
"""

# ── 전사 지표 ──────────────────────────────────────────────────────────────
# DDL에서 나올 수 없는 유일한 부분입니다. "도메인 수집 완료 건수"가 무엇을
# 뜻하는지는 스키마가 아니라 조직이 정합니다.
#
# fixed_filters는 이 지표를 쓰면 반드시 붙습니다. 모델이 넣어주기를 기대하는
# 것이 아니라 정의가 그렇기 때문에 붙는 것이고, 그것이 시맨틱 레이어의 요점입니다.
_METRICS = [
    {
        "name": "collected_domain_count",
        "description": "도메인 수집이 완료된 URL 건수. 수집 여부가 참인 것만 센다.",
        "table": "TB_ASPIRIN_URL",
        "formula": "COUNT(ASPIRIN_URL_ID)",
        "fixed_filters": [
            {"field": "DOMAIN_COLLECT_YN", "operator": "equals", "value": 1},
        ],
    },
]

# ── 탐색 결과 예산 ─────────────────────────────────────────────────────────
# 1단계가 돌려준 스키마는 그대로 프롬프트에 남아 2단계, 3단계까지 따라다닙니다.
# 게이트웨이 모델의 컨텍스트가 16k라 이 예산이 곧 실패 여부입니다.
#
# 컬럼 110개짜리 테이블을 들여쓴 JSON으로 내보내면 컬럼당 130자, 한 테이블에
# 14,000자입니다. 같은 주석을 단 사본 테이블까지 잡히면 그 세 배가 되고, 첫
# 호출에서 400 context length로 끝납니다. 그래서 형식은 한 줄에 컬럼 하나입니다.
MAX_COLUMNS = 30
MAX_CHARS = 3000

_FUNCTIONS = ("SUM", "COUNT", "AVG", "MIN", "MAX")
_OPERATORS = {
    "equals": "=",
    "not_equals": "!=",
    "greater_than": ">",
    "less_than": "<",
}


# 컬럼이 아니라 키·제약 정의로 시작하는 줄. 인용되지 않은 키워드로만 시작하므로
# `key`라는 이름의 컬럼(백틱으로 시작)과 헷갈리지 않습니다.
_NOT_A_COLUMN = (
    "primary key", "unique key", "unique index", "foreign key", "constraint",
    "key ", "key`", "index ", "index`", "fulltext", "spatial", "check ", "period ",
)


def _split_top_level(text: str) -> list:
    """최상위 콤마로 자릅니다.

    `decimal(10,2)`의 콤마는 괄호 안이고 `enum('A','B')`의 콤마는 괄호와 따옴표
    안입니다. 그냥 split(',')하면 두 경우 모두 컬럼 하나가 둘로 쪼개지고, 쪼개진
    조각은 컬럼으로도 키로도 안 읽혀 조용히 사라집니다.
    """
    parts, buffer, depth, quote = [], [], 0, None
    index = 0
    while index < len(text):
        char = text[index]
        if quote:
            buffer.append(char)
            if char == quote:
                # 같은 따옴표가 연달아 나오면 이스케이프이지 닫는 따옴표가 아닙니다.
                if index + 1 < len(text) and text[index + 1] == quote:
                    buffer.append(text[index + 1])
                    index += 2
                    continue
                quote = None
            index += 1
            continue
        if char in "'`\"":
            quote = char
        elif char == "(":
            depth += 1
        elif char == ")":
            depth -= 1
        elif char == "," and depth == 0:
            parts.append("".join(buffer))
            buffer = []
            index += 1
            continue
        buffer.append(char)
        index += 1
    if "".join(buffer).strip():
        parts.append("".join(buffer))
    return parts


def _quoted_after(text: str, keyword: str) -> str:
    """`keyword` 뒤에 오는 작은따옴표 문자열. 없으면 빈 문자열.

    정규식으로 `COMMENT '(.*?)'`를 잡으면 주석 안의 `''`(이스케이프된 따옴표)에서
    먼저 끊깁니다. "고객의 '등급'" 같은 주석이 실제로 그렇게 잘립니다.
    """
    import re

    found = re.search(rf"\b{keyword}\b\s*=?\s*'", text, re.IGNORECASE)
    if not found:
        return ""

    out, index = [], found.end()
    while index < len(text):
        char = text[index]
        if char == "'":
            if index + 1 < len(text) and text[index + 1] == "'":
                out.append("'")
                index += 2
                continue
            break
        out.append(char)
        index += 1
    return "".join(out)


def _closing_paren(text: str, start: int) -> int:
    """`start`의 여는 괄호와 짝이 되는 닫는 괄호 위치. 따옴표 안은 세지 않습니다."""
    depth, quote, index = 0, None, start
    while index < len(text):
        char = text[index]
        if quote:
            if char == quote and not (
                index + 1 < len(text) and text[index + 1] == quote
            ):
                quote = None
            elif char == quote:
                index += 1
        elif char in "'`\"":
            quote = char
        elif char == "(":
            depth += 1
        elif char == ")":
            depth -= 1
            if depth == 0:
                return index
        index += 1
    raise ValueError("CREATE TABLE의 괄호가 닫히지 않았습니다")


def _parse_ddl(ddl: str) -> list:
    """CREATE TABLE 문에서 테이블·컬럼·주석을 읽어냅니다.

    COMMENT를 description으로 씁니다. 프루너가 검색하는 본문이 그것이고, 주석 없는
    컬럼은 이름만으로 검색됩니다 — 한글로 물어보는 사용자에게는 거의 안 걸립니다.

    조용히 넘어가지 않고 예외를 냅니다. 컬럼 하나가 빠진 계약서는 그 컬럼만 못 쓰는
    에이전트가 되는데, 그 증상은 "모델이 컬럼을 잘못 골랐네"로 보이지 파싱 실패로는
    안 보입니다. 소스 로드 단계에서 터지는 편이 낫습니다.
    """
    import re

    tables = []
    # 시작 위치를 먼저 모읍니다. 각 문의 끝을 다음 문의 시작으로 잡기 위해서입니다.
    heads = list(re.finditer(r"CREATE\s+TABLE\s+", ddl, re.IGNORECASE))
    for index, head in enumerate(heads):
        limit = heads[index + 1].start() if index + 1 < len(heads) else len(ddl)

        opening = ddl.find("(", head.end())
        if opening < 0 or opening > limit:
            continue
        closing = _closing_paren(ddl, opening)

        name = ddl[head.end() : opening].strip()
        name = re.sub(r"(?i)^IF\s+NOT\s+EXISTS\s+", "", name).strip()
        # `db`.`tbl`로 나오면 테이블 이름만 취합니다.
        name = name.split(".")[-1].strip().strip("`\"[] ")
        if not name:
            continue

        columns = []
        for part in _split_top_level(ddl[opening + 1 : closing]):
            stripped = part.strip()
            if not stripped:
                continue
            if stripped.lower().startswith(_NOT_A_COLUMN):
                continue

            matched = re.match(r"`([^`]+)`\s*(.*)|([A-Za-z_][A-Za-z0-9_]*)\s*(.*)",
                               stripped, re.S)
            if not matched:
                raise ValueError(f"컬럼 정의를 읽을 수 없습니다 -> {stripped[:60]!r}")
            column = matched.group(1) or matched.group(3)
            rest = (matched.group(2) or matched.group(4) or "").strip()

            columns.append({
                "name": column,
                # 타입은 첫 공백까지. 괄호 안의 공백(`decimal(10, 2)`)은 넘어갑니다.
                "type": _leading_type(rest),
                "description": _quoted_after(rest, "COMMENT"),
            })

        if not columns:
            raise ValueError(f"테이블 {name!r}에서 컬럼을 하나도 읽지 못했습니다")

        tables.append({
            "name": name,
            # 닫는 괄호부터 **다음 CREATE 직전까지**. 고정 길이로 잘라 읽으면 테이블
            # 주석이 없을 때 다음 테이블 첫 컬럼의 COMMENT를 제 것으로 가져옵니다 —
            # 조용히 틀린 설명이 붙고, 프루너는 그 설명으로 검색합니다.
            "description": _quoted_after(ddl[closing:limit], "COMMENT"),
            "columns": columns,
        })

    if not tables:
        raise ValueError("_DDL에서 CREATE TABLE 문을 찾지 못했습니다")
    return tables


def _leading_type(text: str) -> str:
    """`varchar(36)`, `int(11)`, `decimal(10, 2)`, `enum('A','B')`까지 한 덩어리로."""
    depth = 0
    for index, char in enumerate(text):
        if char == "(":
            depth += 1
        elif char == ")":
            depth -= 1
        elif char.isspace() and depth == 0:
            return text[:index]
    return text


_CONTRACT = {"tables": _parse_ddl(_DDL), "metrics": _METRICS}


def _tokens(text: str) -> list:
    """단어로 쪼갠 결과. 한글은 글자 2-gram으로 끊습니다.

    공백으로만 자르면 "매출액의"와 "매출액"이 서로 다른 토큰이 되어, 조사 하나
    때문에 관련 테이블을 놓칩니다. 2-gram이면 "매출","출액"이 겹쳐서 잡힙니다.
    """
    import re

    found = []
    for match in re.finditer(r"[a-z0-9_]+|[가-힣一-鿿]+", text.lower()):
        chunk = match.group()
        if chunk[0].isascii():
            found.append(chunk)
        elif len(chunk) == 1:
            found.append(chunk)
        else:
            found.extend(chunk[i : i + 2] for i in range(len(chunk) - 1))
    return found


class _Pruner:
    """질문과 관련 있는 테이블·지표만 골라냅니다.

    전체 계약서를 프롬프트에 넣으면 테이블이 늘어날수록 토큰과 노이즈가 같이
    늘고, 모델이 엉뚱한 테이블을 고를 여지도 같이 커집니다.

    TF-IDF를 직접 구현한 이유는 의존성입니다. scikit-learn은 numpy·scipy까지
    100MB가 넘고, 생성된 에이전트는 `uv run`으로 제 의존성을 직접 설치합니다.
    테이블 설명 몇 개를 정렬하는 데 치를 값은 아닙니다.
    """

    def __init__(self, contract: dict) -> None:
        self.entries = []
        for table in contract.get("tables", []):
            text = " ".join(
                [table["name"], table.get("description", "")]
                + [c.get("description", "") for c in table.get("columns", [])]
                + [c["name"] for c in table.get("columns", [])]
            )
            self.entries.append(("table", table, _tokens(text)))
        for metric in contract.get("metrics", []):
            text = " ".join(
                [metric["name"], metric.get("description", ""), metric.get("table", "")]
            )
            self.entries.append(("metric", metric, _tokens(text)))

        # 문서 빈도: 몇 개의 항목에 이 토큰이 나오는가.
        self.document_count = len(self.entries) or 1
        self.frequency = {}
        for _kind, _data, tokens in self.entries:
            for token in set(tokens):
                self.frequency[token] = self.frequency.get(token, 0) + 1

    def _weights(self, tokens: list) -> dict:
        """TF-IDF 벡터. IDF는 로그 스무딩이라 모든 항목에 나오는 토큰도 0이 아닙니다."""
        import math

        counts = {}
        for token in tokens:
            counts[token] = counts.get(token, 0) + 1

        weights = {}
        for token, count in counts.items():
            appears = self.frequency.get(token, 0)
            idf = math.log(self.document_count / (1 + appears)) + 1.0
            weights[token] = count * idf
        return weights

    def _cosine(self, left: dict, right: dict) -> float:
        import math

        shared = set(left) & set(right)
        if not shared:
            return 0.0
        dot = sum(left[token] * right[token] for token in shared)
        size = math.sqrt(sum(v * v for v in left.values())) * math.sqrt(
            sum(v * v for v in right.values())
        )
        return dot / size if size else 0.0

    def prune(self, question: str, top_k: int = 3, relative: float = 0.3) -> dict:
        """상위 top_k개 중, 1등 점수의 `relative` 배 이상인 것만.

        고정 개수로만 자르면 한 테이블이 압도적으로 관련 있을 때도 2등이 딸려
        옵니다 — 웹 트래픽 질문에서 매출 테이블이 0.50 대 0.06으로 밀리고도
        프롬프트에 들어가는 식입니다. 상대 문턱은 지표와 그 테이블처럼 둘 다
        높게 나오는 경우는 함께 남기면서 그런 찌꺼기만 떨굽니다.
        """
        query = self._weights(_tokens(question))
        scored = sorted(
            (
                (self._cosine(query, self._weights(tokens)), kind, data)
                for kind, data, tokens in self.entries
            ),
            key=lambda row: row[0],
            reverse=True,
        )

        best = scored[0][0] if scored else 0.0
        floor = best * relative

        tables, metrics = [], []
        for score, kind, data in scored[:top_k]:
            if score <= 0 or score < floor:
                continue
            if kind == "metric":
                metrics.append(data)
                tables.append(data["table"])
            else:
                tables.append(data["name"])

        # 아무것도 걸리지 않으면 전부 보여줍니다. 빈 스키마를 받은 모델은 컬럼을
        # 지어내기 시작하고, 그 편이 프롬프트가 조금 긴 것보다 나쁩니다.
        wanted = set(tables) or {t["name"] for t in _CONTRACT["tables"]}
        return {
            "tables": [t for t in _CONTRACT["tables"] if t["name"] in wanted],
            "metrics": metrics,
        }


def _describe(pruned: dict, question: str) -> str:
    """프루닝 결과를 모델이 읽을 압축 텍스트로.

    JSON을 버린 이유는 순전히 크기입니다. 같은 내용이 들여쓴 JSON에서는 컬럼당
    130자, 여기서는 30자 안팎입니다. 모델이 읽어야 하는 것은 이름·타입·설명
    셋뿐이고, 중괄호와 따옴표는 그 셋을 담느라 낸 비용이었습니다.
    """
    blocks = []

    for metric in pruned.get("metrics", []):
        pinned = ", ".join(
            f"{f['field']}={f['value']!r}" for f in metric.get("fixed_filters") or []
        )
        blocks.append(
            f"METRIC {metric['name']} — {metric.get('description', '')}\n"
            f"  table={metric['table']} {metric.get('formula', '')}"
            + (f" 고정조건({pinned})" if pinned else "")
        )

    # 테이블 여러 개가 잡히면 예산을 나눠 씁니다. 각자 30개씩 가져가면 총량이
    # 상한을 넘고, 그때는 마지막 테이블이 줄 중간에서 잘려 나갑니다.
    tables = pruned.get("tables", [])
    budget = max(8, MAX_COLUMNS // max(len(tables), 1))

    for table in tables:
        shown, hidden = _pick_columns(table["columns"], question, budget)
        head = f"TABLE {table['name']}"
        if table.get("description"):
            head += f" — {table['description']}"
        if hidden:
            head += f"  (컬럼 {len(table['columns'])}개 중 질문에 가까운 {len(shown)}개만)"

        rows = [
            f"  {c['name']} {c.get('type', '')} {c.get('description', '')}".rstrip()
            for c in shown
        ]
        blocks.append("\n".join([head, *rows]))

    text = "\n\n".join(blocks) or "(관련 테이블을 찾지 못했습니다)"
    if len(text) > MAX_CHARS:
        # 마지막 온전한 줄까지만. 줄 한가운데서 자르면 반쪽짜리 컬럼 이름이
        # 남고, 모델은 그것을 진짜 이름으로 받아 적습니다.
        text = text[:MAX_CHARS].rsplit("\n", 1)[0]
        # 잘렸다는 사실은 반드시 남깁니다. 조용히 자르면 모델은 없는 컬럼을
        # 지어내고, 그 실패는 프롬프트 예산 문제처럼 보이지 않습니다.
        text += "\n... (길어서 잘랐습니다. 질문을 좁혀 다시 물어보세요)"
    return text


def _pick_columns(columns: list, question: str, limit: int):
    """넓은 테이블에서 질문에 가까운 컬럼만 고릅니다. (고른 것, 감춘 개수)

    110개짜리 테이블을 통째로 내보내면 그 한 번으로 컨텍스트가 끝납니다. 질문과
    겹치는 토큰이 많은 순으로 고르되, **원래 순서로 되돌려** 내보냅니다 — 점수순
    나열은 사람이 읽기 어렵고, DDL 순서에는 키가 앞에 오는 정보가 들어 있습니다.
    """
    if len(columns) <= limit:
        return columns, 0

    wanted = set(_tokens(question))

    def overlap(column: dict) -> int:
        text = f"{column['name']} {column.get('description', '')}"
        return len(wanted & set(_tokens(text)))

    ranked = sorted(columns, key=overlap, reverse=True)[:limit]
    keep = {id(c) for c in ranked}
    shown = [c for c in columns if id(c) in keep]
    return shown, len(columns) - len(shown)


def _match(name, options):
    """대소문자를 무시하고 이름을 찾아 계약서에 적힌 표기로 돌려줍니다.

    이 스키마의 이름은 `TB_ASPIRIN_URL`, `DOMAIN_COLLECT_YN`처럼 전부 대문자인데
    모델은 소문자로 적는 쪽으로 기웁니다. MariaDB 자체는 컬럼명 대소문자를 가리지
    않으므로, 여기서 막으면 DB가 받아줬을 쿼리를 우리가 거절하는 셈입니다.

    화이트리스트가 느슨해지는 것은 아닙니다. 계약서에 없는 이름은 그대로 없고,
    SQL에 나가는 것은 언제나 계약서 쪽 표기입니다.
    """
    if not isinstance(name, str):
        return None
    if name in options:
        return name
    lowered = name.lower()
    for candidate in options:
        if candidate.lower() == lowered:
            return candidate
    return None


class _Compiler:
    """검증된 AST를 SQL로 조립합니다.

    모델이 무엇을 넘기든 여기서 화이트리스트를 통과하지 못하면 SQL이 되지
    않습니다. 테이블·컬럼·집계함수·연산자 네 가지 모두 계약서에 있는 것만 허용합니다.
    """

    def __init__(self, contract: dict) -> None:
        self.columns = {
            t["name"]: [c["name"] for c in t["columns"]] for t in contract["tables"]
        }
        self.metrics = {m["name"]: m for m in contract.get("metrics", [])}

    # AST가 이해하는 키의 전부. 모르는 키는 조용히 버리지 않고 거부합니다.
    KEYS = {"target_table", "metric", "aggregations", "filters", "group_by"}

    # 모델이 자주 시도하지만 이 컴파일러가 만들지 않는 것들. 이름을 알아보고
    # 무엇이 없는지 말해주는 편이, 낯선 키라고만 하는 것보다 고쳐 쓰기 쉽습니다.
    UNSUPPORTED = {
        "order_by": "정렬(ORDER BY)",
        "sort": "정렬(ORDER BY)",
        "limit": "상위 N개 제한(LIMIT)",
        "top": "상위 N개 제한(LIMIT)",
        "having": "집계 결과 필터(HAVING)",
        "joins": "테이블 조인(JOIN)",
        "join": "테이블 조인(JOIN)",
        "distinct": "중복 제거(DISTINCT)",
        "subquery": "서브쿼리",
    }

    def compile(self, ast: dict) -> str:
        # 모르는 키를 무시하면 "상위 10개만"이라는 질문에 LIMIT 없는 쿼리가
        # 나가고, 아무도 그 사실을 말하지 않습니다. 모델은 답했다고 믿고
        # 사용자에게 내놓습니다 — 에러보다 나쁜 결과입니다.
        unknown = set(ast) - self.KEYS
        if unknown:
            named = [self.UNSUPPORTED[k] for k in sorted(unknown) if k in self.UNSUPPORTED]
            other = sorted(k for k in unknown if k not in self.UNSUPPORTED)
            parts = []
            if named:
                parts.append(
                    "이 도구는 " + ", ".join(dict.fromkeys(named)) + "을(를) 만들지 않습니다"
                )
            if other:
                parts.append(f"모르는 항목입니다 -> {', '.join(other)}")
            raise ValueError(
                "; ".join(parts)
                + ". 쓸 수 있는 것: target_table 또는 metric, aggregations, "
                "filters, group_by. 그 범위로 다시 만들거나, 불가능하면 "
                "사용자에게 그렇게 답하십시오"
            )

        aggregations = list(ast.get("aggregations") or [])
        filters = list(ast.get("filters") or [])
        asked = ast.get("target_table")

        # 지표를 지정하면 그 정의가 테이블과 집계식과 고정 필터를 함께 결정합니다.
        metric_name = _match(ast.get("metric"), self.metrics)
        if ast.get("metric"):
            metric = self.metrics.get(metric_name)
            if metric is None:
                raise ValueError(
                    f"정의되지 않은 지표입니다 -> {ast.get('metric')!r} "
                    f"(사용 가능: {', '.join(self.metrics) or '없음'})"
                )
            asked = metric["table"]
            aggregations.append(self._metric_aggregation(metric))
            filters = self._merge_fixed(filters, metric)

        table = _match(asked, self.columns)
        if table is None:
            raise ValueError(
                f"조회할 수 없는 테이블입니다 -> {asked!r} "
                f"(사용 가능: {', '.join(self.columns)})"
            )
        allowed = self.columns[table]

        select = ", ".join(self._aggregation(a, table, allowed) for a in aggregations)
        clauses = [f"SELECT {select or '*'}", f"FROM {self._identifier(table)}"]

        where = [self._filter(f, table, allowed) for f in filters]
        if where:
            clauses.append("WHERE " + " AND ".join(where))

        grouping = []
        for column in ast.get("group_by") or []:
            resolved = _match(column, allowed)
            if resolved is None:
                raise ValueError(f"그룹화할 수 없는 컬럼입니다 -> {table}.{column}")
            grouping.append(resolved)
        if grouping:
            clauses.append(
                "GROUP BY " + ", ".join(self._identifier(c) for c in grouping)
            )

        return " ".join(clauses) + ";"

    def _metric_aggregation(self, metric: dict) -> dict:
        """지표의 formula를 함수와 컬럼으로 되돌립니다.

        문자열을 그대로 SELECT에 붙이면 계약서를 고칠 수 있는 사람이 임의의 SQL을
        심을 수 있습니다. 쪼개서 다른 집계와 똑같이 검증받게 합니다.
        """
        import re

        formula = str(metric.get("formula", ""))
        parsed = re.fullmatch(r"\s*([A-Za-z]+)\s*\(\s*([A-Za-z0-9_*]+)\s*\)\s*", formula)
        if not parsed:
            raise ValueError(
                f"지표 {metric['name']!r}의 formula를 해석할 수 없습니다 -> {formula!r} "
                "(FUNC(column) 형태여야 합니다)"
            )
        return {
            "function": parsed.group(1),
            "field": parsed.group(2),
            "alias": metric["name"],
        }

    def _merge_fixed(self, supplied: list, metric: dict) -> list:
        """지표의 고정 필터를 반드시 적용합니다.

        시맨틱 레이어의 존재 이유가 이 한 줄입니다. active_revenue를 물었으면
        contract_status = 'ACTIVE'는 모델이 넣어줬기 때문이 아니라 지표 정의가
        그렇기 때문에 붙어야 합니다.

        모델이 같은 컬럼에 다른 값을 걸었다면 그냥 AND로 이어붙이지 않고 거부합니다.
        모순된 조건은 빈 결과를 내는데, 그건 "데이터가 없음"처럼 보이지 거버넌스
        위반처럼 보이지 않습니다.
        """
        fixed = metric.get("fixed_filters") or []
        pinned = {f["field"]: f for f in fixed}

        merged = []
        for condition in supplied:
            # 고정 컬럼을 소문자로 적어 보내도 충돌로 잡아야 합니다. 여기서 놓치면
            # 같은 컬럼에 두 조건이 AND로 붙어 조용히 빈 결과가 됩니다.
            pin = pinned.get(_match(condition.get("field"), pinned))
            if pin and (
                condition.get("value") != pin["value"]
                or condition.get("operator") != pin["operator"]
            ):
                raise ValueError(
                    f"지표 {metric['name']!r}는 {pin['field']}를 "
                    f"{pin['value']!r}로 고정합니다. 다른 조건을 걸 수 없습니다 "
                    f"-> {condition!r}"
                )
            if pin is None:
                merged.append(condition)
        return merged + list(fixed)

    def _aggregation(self, spec: dict, table: str, allowed: list) -> str:
        field = spec.get("field")
        function = str(spec.get("function", "")).upper()
        alias = spec.get("alias") or f"{function.lower()}_{field}"

        if function not in _FUNCTIONS:
            raise ValueError(
                f"허용되지 않은 집계 함수입니다 -> {function!r} "
                f"(사용 가능: {', '.join(_FUNCTIONS)})"
            )
        resolved = field if field == "*" else _match(field, allowed)
        if resolved is None:
            raise ValueError(f"존재하지 않는 컬럼입니다 -> {table}.{field}")
        # COUNT(*)의 별은 컬럼이 아니라 문법이라 감싸면 안 됩니다.
        target = "*" if field == "*" else self._identifier(resolved)
        return f"{function}({target}) AS {self._alias(alias)}"

    def _identifier(self, name: str) -> str:
        """계약서에 있는 이름을 백틱으로 감쌉니다 — MariaDB의 인용 문자입니다.

        예약어가 목적입니다: `status`, `order`, `rank`는 모두 그럴듯한 컬럼명이면서
        MariaDB 예약어라, 감싸지 않으면 문법 오류가 납니다.

        영문/숫자/밑줄만 받으면 안 됩니다. 실제 스키마에는 `평균기온(°C)`,
        `1시간 최다강수량(mm)`, `사고원인-대분류` 같은 컬럼이 있고, MariaDB는
        백틱만 씌우면 이들을 문제없이 받습니다. 좁게 막으면 DB가 받아줬을 쿼리를
        우리가 거절하게 됩니다.

        백틱 안에서 특별한 문자는 백틱 자신뿐이라, 그것과 NUL만 거부하면 인용이
        깨지지 않습니다. 이름은 이미 계약서 화이트리스트를 통과한 것이므로
        주입 경로도 아닙니다.
        """
        text = str(name)
        if not text:
            raise ValueError("빈 식별자는 쓸 수 없습니다")
        if "`" in text or "\x00" in text:
            raise ValueError(f"식별자에 백틱이나 NUL을 쓸 수 없습니다 -> {name!r}")
        return f"`{text}`"

    def _alias(self, alias: str) -> str:
        """별칭은 계약서에 없는, 모델이 그때그때 지어내는 유일한 식별자입니다.

        화이트리스트가 받쳐주지 않는데도 컬럼명과 같은 문자 규칙을 씁니다. 백틱
        안에서 특별한 문자는 백틱뿐이므로, 그것만 막으면 모델이 무엇을 적어 보내든
        SQL 구조에 영향을 주지 못하고 이름으로만 남습니다 — 값을 홑따옴표 안에
        가두는 것과 같은 논리입니다.

        영문만 받으면 한글 컬럼을 집계할 때 `사망자수합계` 같은 자연스러운 별칭이
        거절됩니다. MariaDB는 받아주는 이름입니다.

        길이와 공백은 별칭에만 있는 제약입니다. MariaDB 식별자는 64자를 넘을 수
        없고 공백으로 끝날 수 없는데, 계약서의 이름과 달리 모델의 별칭은 그 둘을
        지킨다는 보장이 없습니다.
        """
        text = str(alias)
        if not text or text != text.strip():
            raise ValueError(f"별칭은 비어 있거나 공백으로 끝날 수 없습니다 -> {alias!r}")
        if len(text) > 64:
            raise ValueError(f"별칭은 64자를 넘을 수 없습니다 -> {text[:20]}...")
        if "`" in text or "\x00" in text:
            raise ValueError(f"별칭에 백틱이나 NUL을 쓸 수 없습니다 -> {alias!r}")
        return f"`{text}`"

    def _filter(self, spec: dict, table: str, allowed: list) -> str:
        field = spec.get("field")
        operator = spec.get("operator")

        resolved = _match(field, allowed)
        if resolved is None:
            raise ValueError(f"필터링할 수 없는 컬럼입니다 -> {table}.{field}")
        if operator not in _OPERATORS:
            raise ValueError(
                f"허용되지 않는 비교 연산자입니다 -> {operator!r} "
                f"(사용 가능: {', '.join(_OPERATORS)})"
            )
        return (
            f"{self._identifier(resolved)} {_OPERATORS[operator]} "
            f"{self._literal(spec.get('value'))}"
        )

    def _literal(self, value) -> str:
        """값을 SQL 리터럴로. 식별자와 달리 값은 화이트리스트로 막을 수 없습니다.

        **백슬래시 거부는 MariaDB에서 선택이 아닙니다.** MariaDB는 기본 sql_mode에
        NO_BACKSLASH_ESCAPES가 없어서 문자열 안의 백슬래시가 이스케이프 문자입니다.
        홑따옴표 겹치기만으로 막으면 `\\' OR 1=1 -- ` 같은 값이 `'\\'' OR 1=1 -- '`가
        되고, 여기서 `\\'`가 따옴표를 이스케이프해 리터럴을 빠져나갑니다.
        PostgreSQL은 standard_conforming_strings가 기본 on이라 같은 값이 안전하지만,
        이 에이전트가 붙는 곳은 MariaDB입니다.

        데이터에 정상적으로 백슬래시가 들어간다면, 거부 대신 서버에
        NO_BACKSLASH_ESCAPES를 켜는 쪽이 맞습니다. 값을 인라인하지 않고
        플레이스홀더로 빼는 것이 정공법이고요 — 아래 semantic_sql 주석 참고.
        """
        if isinstance(value, bool):
            # MariaDB는 TRUE/FALSE를 1/0의 별칭으로 받습니다.
            return "TRUE" if value else "FALSE"
        if isinstance(value, (int, float)):
            return str(value)
        if value is None:
            return "NULL"

        text = str(value)
        if "\x00" in text:
            raise ValueError("값에 NUL 문자를 넣을 수 없습니다")
        if "\\" in text:
            raise ValueError(
                "값에 백슬래시를 넣을 수 없습니다 "
                "(MariaDB에서 백슬래시는 이스케이프 문자입니다)"
            )
        return "'" + text.replace("'", "''") + "'"


@tool("semantic_sql")
def semantic_sql(question: str = "", ast: str = "") -> str:
    """Turn a data question into safe SQL, in two steps.

    Step 1 - discovery: call with `question` only. Returns the tables, columns and
    governed metrics relevant to that question.
    Step 2 - compile: call with `ast`, a JSON object built from what step 1 returned.

        {"metric": "active_revenue", "filters": [{"field": "country_code",
         "operator": "equals", "value": "KR"}], "group_by": []}

    or, without a metric:

        {"target_table": "gold_sales_summary",
         "aggregations": [{"field": "sales_amount", "function": "SUM",
                           "alias": "total"}],
         "filters": [], "group_by": []}

    Prefer `metric` when one fits: its filters are applied for you. Never invent a
    table or column that step 1 did not return.
    """
    import json

    if not (question or "").strip() and not (ast or "").strip():
        return "error: 'question'(탐색) 또는 'ast'(컴파일) 중 하나는 필요합니다"

    # 탐색: 질문만 왔으면 관련 스키마를 돌려줍니다.
    if not (ast or "").strip():
        return _describe(_Pruner(_CONTRACT).prune(question), question)

    payload = (ast or "").strip()
    # 모델이 코드펜스를 붙여 보내는 일이 흔하고, 그것 때문에 실패시킬 이유는 없습니다.
    if payload.startswith("```"):
        payload = payload.split("\n", 1)[-1].rsplit("```", 1)[0].strip()

    try:
        parsed = json.loads(payload)
    except json.JSONDecodeError as error:
        return f"error: ast가 올바른 JSON이 아닙니다 -> {error}"
    if not isinstance(parsed, dict):
        return f"error: ast는 JSON 객체여야 합니다 (받은 것: {type(parsed).__name__})"

    try:
        return _Compiler(_CONTRACT).compile(parsed)
    except (ValueError, KeyError, TypeError) as error:
        # 예외를 올리지 않고 문자열로 돌려주는 쪽이, 모델이 스스로 고쳐 다시
        # 호출할 수 있어서 낫습니다. 실행이 끊기면 그럴 기회가 없습니다.
        return f"error: {error}"
