def recursion_limit() -> int:
    """Counts node transitions, and a react turn costs two, plus entry and exit."""
    return 2 * MAX_ITERATIONS + 4


def build_graph(model: ChatOpenAI):
    """agent -> (tool calls? tools -> agent : END)"""
    callbacks = tools()
    # bind_tools([]) is not the same as not binding: some gateways reject an empty
    # tools array outright, so an agent with no tools is given a plain model.
    bound = model.bind_tools(callbacks) if callbacks else model

    def agent(state: State) -> dict:
        return {"messages": [bound.invoke(prompt_messages(state["messages"]))]}

    def route(state: State) -> str:
        last = state["messages"][-1]
        return "tools" if getattr(last, "tool_calls", None) else END

    graph = StateGraph(State)
    graph.add_node("agent", agent)
    graph.add_edge(START, "agent")

    if callbacks:
        graph.add_node("tools", ToolNode(callbacks))
        graph.add_conditional_edges("agent", route, {"tools": "tools", END: END})
        graph.add_edge("tools", "agent")
    else:
        # No tools node at all rather than an unreachable one: the flow tab draws what
        # this builds, and a node nothing can enter would be a lie about the run.
        graph.add_edge("agent", END)

    return graph.compile(checkpointer=MemorySaver())
