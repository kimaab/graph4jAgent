# Each step feeds everything produced before it into the next prompt.
STEP_PROMPTS = [
__STEP_PROMPTS__
]


def recursion_limit() -> int:
    """A linear chain cannot loop, so the limit is only a backstop."""
    return 2 * len(STEP_PROMPTS) + 8


def build_graph(model: ChatOpenAI):
    """step_0 -> step_1 -> ... -> END. Tools are not called from a linear graph."""
    graph = StateGraph(State)

    def step(prompt: str):
        # The prompt is bound here rather than read from the loop variable inside the
        # node: closing over the variable would give every node the last step's prompt.
        def run(state: State) -> dict:
            ask = HumanMessage(prompt)
            history = [*state["messages"], ask]
            # The prompt goes into the state alongside the reply, so the next step sees
            # what was asked and not just what came back.
            return {"messages": [ask, model.invoke(prompt_messages(history))]}

        return run

    names = []
    for index, prompt in enumerate(STEP_PROMPTS):
        name = f"step_{index}"
        names.append(name)
        graph.add_node(name, step(prompt))

    graph.add_edge(START, names[0])
    for current, following in zip(names, names[1:]):
        graph.add_edge(current, following)
    graph.add_edge(names[-1], END)

    return graph.compile(checkpointer=MemorySaver())
