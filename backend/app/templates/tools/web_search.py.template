@tool("web_search")
def web_search(query: str) -> str:
    """Search the web and return result snippets.

    A stub. The signature is the real one so a search backend can be dropped in without
    touching the graph or the generated code; the body just says so.
    """
    if not query or not query.strip():
        return "error: 'query' is required"
    return (
        "web_search is not wired to a search backend yet. "
        f"No results available for: {query}"
    )

