class _Arithmetic:
    """A closed grammar: numbers, + - * / %, parentheses and unary minus.

    `eval` would be the short path and would also hand the model arbitrary code
    execution, so nothing outside this grammar parses.
    """

    def __init__(self, source: str) -> None:
        self.source = source
        self.pos = 0

    def parse(self) -> float:
        value = self.expression()
        self.skip_spaces()
        if self.pos < len(self.source):
            raise ValueError(
                f"unexpected character {self.source[self.pos]!r} at position {self.pos}"
            )
        return value

    def expression(self) -> float:
        """expression := term (('+' | '-') term)*"""
        value = self.term()
        while True:
            if self.eat("+"):
                value += self.term()
            elif self.eat("-"):
                value -= self.term()
            else:
                return value

    def term(self) -> float:
        """term := factor (('*' | '/' | '%') factor)*"""
        value = self.factor()
        while True:
            if self.eat("*"):
                value *= self.factor()
            elif self.eat("/"):
                value /= self.non_zero()
            elif self.eat("%"):
                value %= self.non_zero()
            else:
                return value

    def factor(self) -> float:
        """factor := ('+' | '-')? (number | '(' expression ')')"""
        if self.eat("+"):
            return self.factor()
        if self.eat("-"):
            return -self.factor()
        if self.eat("("):
            value = self.expression()
            if not self.eat(")"):
                raise ValueError("unbalanced parenthesis")
            return value
        return self.number()

    def number(self) -> float:
        self.skip_spaces()
        start = self.pos
        while self.pos < len(self.source) and (
            self.source[self.pos].isdigit() or self.source[self.pos] == "."
        ):
            self.pos += 1
        if start == self.pos:
            raise ValueError(f"expected a number at position {self.pos}")
        try:
            return float(self.source[start : self.pos])
        except ValueError:
            raise ValueError(f"malformed number {self.source[start : self.pos]!r}") from None

    def non_zero(self) -> float:
        divisor = self.factor()
        if divisor == 0:
            raise ZeroDivisionError("division by zero")
        return divisor

    def eat(self, expected: str) -> bool:
        self.skip_spaces()
        if self.pos < len(self.source) and self.source[self.pos] == expected:
            self.pos += 1
            return True
        return False

    def skip_spaces(self) -> None:
        while self.pos < len(self.source) and self.source[self.pos].isspace():
            self.pos += 1


@tool("calculator")
def calculator(expression: str) -> str:
    """Evaluate an arithmetic expression and return the numeric result.

    `expression` is arithmetic only, e.g. (3 + 4) * 2.
    """
    if not expression or not expression.strip():
        return "error: 'expression' is required"
    try:
        value = _Arithmetic(expression).parse()
    except (ArithmeticError, ValueError) as error:
        return f"error: {error}"

    import math

    # Whole results read better without the trailing .0, but only a finite value can be
    # compared to its integer form at all.
    if math.isfinite(value) and value == int(value):
        return str(int(value))
    return str(value)

