public class __CLASS_NAME__ {

    static final String BASE_URL = env("LLM_BASE_URL", "__BASE_URL__");
    static final String API_KEY = env("LLM_API_KEY", "__API_KEY__");
    static final String MODEL = "__MODEL__";
    static final String SYSTEM_PROMPT = __SYSTEM_PROMPT__;
    static final int MAX_ITERATIONS = __MAX_ITERATIONS__;

    public static void main(String[] args) throws Exception {
        String message = args.length > 0 ? String.join(" ", args) : "안녕하세요";

        // Both clients are needed: OpenAiChatModel builds an async one for streaming,
        // and it will not inherit credentials from the synchronous client.
        OpenAIClient client = OpenAIOkHttpClient.builder()
                .baseUrl(BASE_URL)
                .apiKey(API_KEY)
                .build();
        OpenAIClientAsync asyncClient = OpenAIOkHttpClientAsync.builder()
                .baseUrl(BASE_URL)
                .apiKey(API_KEY)
                .build();
        ChatModel chatModel = OpenAiChatModel.builder()
                .openAiClient(client)
                .openAiClientAsync(asyncClient)
                .build();

        Optional<State> result = buildGraph(chatModel).invoke(
                Map.of(MessagesState.MESSAGES_STATE, new UserMessage(message)),
                RunnableConfig.builder().threadId("cli").build());

        System.out.println(result.flatMap(State::lastMessage)
                .map(Message::getText)
                .orElse("(no answer)"));
    }

__GRAPH_BUILDER__

    /** Prepends the system prompt, when there is one. */
    static List<Message> promptMessages(List<Message> history) {
        List<Message> messages = new ArrayList<>();
        if (!SYSTEM_PROMPT.isBlank()) {
            messages.add(new SystemMessage(SYSTEM_PROMPT));
        }
        messages.addAll(history);
        return messages;
    }

    /**
     * Starts from the model's own options so provider defaults survive. Spring AI does
     * not execute tools inside ChatModel.call, so the graph keeps control of the loop.
     */
    static ChatOptions options(ChatModel chatModel, List<ToolCallback> callbacks) {
        ToolCallingChatOptions.Builder<?> builder =
                chatModel.getOptions() instanceof ToolCallingChatOptions current
                        ? current.mutate()
                        : ToolCallingChatOptions.builder();
        return builder.model(MODEL).toolCallbacks(callbacks).build();
    }

    static AssistantMessage callModel(ChatModel chatModel, List<ToolCallback> callbacks,
                                      List<Message> messages) {
        return chatModel.call(new Prompt(messages, options(chatModel, callbacks)))
                .getResult()
                .getOutput();
    }

    static AssistantMessage lastAssistant(State state) {
        return state.lastMessage()
                .filter(AssistantMessage.class::isInstance)
                .map(AssistantMessage.class::cast)
                .orElseThrow(() -> new IllegalStateException("expected an assistant message"));
    }

    static String env(String name, String fallback) {
        String value = System.getenv(name);
        return value == null || value.isBlank() ? fallback : value;
    }

    /** Conversation state: an append-only list of messages. */
    public static class State extends MessagesState<Message> {
        public State(Map<String, Object> initData) {
            super(initData);
        }
    }

    /** A built-in tool, carrying its own JSON schema. */
    abstract static class Tool implements ToolCallback {
        private final ToolDefinition definition;

        Tool(String name, String description, String inputSchema) {
            this.definition = ToolDefinition.builder()
                    .name(name).description(description).inputSchema(inputSchema).build();
        }

        @Override
        public ToolDefinition getToolDefinition() {
            return definition;
        }

        /** Pulls one string field out of the tool's JSON argument object. */
        static String field(String json, String name) {
            String key = "\"" + name + "\"";
            int at = json.indexOf(key);
            if (at < 0) {
                return null;
            }
            int colon = json.indexOf(':', at + key.length());
            if (colon < 0) {
                return null;
            }
            int start = json.indexOf('"', colon);
            if (start < 0) {
                return null;
            }
            StringBuilder out = new StringBuilder();
            for (int i = start + 1; i < json.length(); i++) {
                char c = json.charAt(i);
                if (c == '\\' && i + 1 < json.length()) {
                    char next = json.charAt(++i);
                    out.append(switch (next) {
                        case 'n' -> '\n';
                        case 't' -> '\t';
                        case 'r' -> '\r';
                        default -> next;
                    });
                } else if (c == '"') {
                    return out.toString();
                } else {
                    out.append(c);
                }
            }
            return null;
        }
    }

__TOOL_CLASSES__

    static List<ToolCallback> tools() {
        return List.of(__TOOL_INSTANCES__);
    }
